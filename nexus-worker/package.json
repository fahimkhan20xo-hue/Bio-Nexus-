{
  "name": "nexus-api",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus backend for BioNexus: Cloudflare Worker + Durable Object quota (Phase 3A, no AI).",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev:local": "node scripts/local-server.mjs",
    "smoke:local": "node scripts/smoke.mjs http://127.0.0.1:8788 staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
